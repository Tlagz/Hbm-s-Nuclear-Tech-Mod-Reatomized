	public static final Map<String, List<Object>> ENTRIES = new LinkedHashMap<>();
	/** Group keys (like "ingotAnyPlastic") -> the keys whose tags they include */
	public static final Map<String, Set<String>> GROUPS = new LinkedHashMap<>();

