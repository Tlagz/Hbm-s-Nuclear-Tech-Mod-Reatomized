		public String wireDense() {		return DENSEWIRE		+ groupName; }
		public String billet() {		return BILLET			+ groupName; }
		public String block() {			return BLOCK			+ groupName; }
		public String ore() {			return ORE				+ groupName; }
		public String lightBarrel() {	return LIGHTBARREL		+ groupName; }
		public String heavyBarrel() {	return HEAVYBARREL		+ groupName; }
		public String lightReceiver() {	return LIGHTRECEIVER	+ groupName; }
