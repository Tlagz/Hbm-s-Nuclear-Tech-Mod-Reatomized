{
  "multipart": [
    {
      "apply": {
        "model": "hbm:block/foundry_channel_center"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_arm"
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_end"
      },
      "when": {
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_arm",
