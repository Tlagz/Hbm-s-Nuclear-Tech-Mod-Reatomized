      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_end",
        "y": 90
      },
      "when": {
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_arm",
        "y": 180
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_end",
        "y": 180
      },
      "when": {
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_arm",
        "y": 270
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "hbm:block/foundry_channel_end",
        "y": 270
      },
      "when": {
        "north": "false"
      }
